    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "skills",
    "README.md",
    "LICENSE",
    "CLAUDE.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "playground": "bun playground/server.ts"
  },
